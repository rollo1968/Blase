<!doctype html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="theme-color" content="#f4f7fb"><title>Blasentagebuch</title>
<style>
:root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172333;background:#f4f7fb}*{box-sizing:border-box}body{margin:0;padding:env(safe-area-inset-top) 14px calc(24px + env(safe-area-inset-bottom));max-width:620px;margin-inline:auto}.head{padding:22px 4px 12px}.head h1{font-size:27px;margin:0 0 5px}.muted{color:#667587;font-size:14px}.card{background:white;border:1px solid #e1e7ef;border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 2px 9px #20334a0a}label,.label{display:block;font-weight:650;font-size:14px;margin:13px 0 7px}input,select{font:inherit;width:100%;padding:13px 12px;border:1px solid #cbd5e1;border-radius:11px;background:#fff;color:#172333;min-height:48px}input:focus,select:focus{outline:2px solid #78aee9;border-color:transparent}.timegrid,.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.urge{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.urge button{border:1px solid #cbd5e1;background:#f7f9fc;border-radius:12px;padding:12px 3px;font-size:19px;font-weight:700;color:#24364a}.urge button small{display:block;font-size:11px;font-weight:500;margin-top:3px;color:#64748b}.urge button.active{background:#e1efff;border:2px solid #377fc2;color:#14558e;padding:11px 2px}.primary,.secondary,.danger{width:100%;border:0;border-radius:12px;padding:15px;font-size:16px;font-weight:700;margin-top:15px}.primary{background:#1769aa;color:white}.secondary{background:#eaf0f6;color:#24364a}.danger{background:#fff0ef;color:#a3312b}.entry{padding:12px 0;border-bottom:1px solid #e8edf3}.entry:last-child{border:0}.entrytop{display:flex;justify-content:space-between;gap:10px;font-weight:700}.entry p{font-size:14px;color:#526174;margin:6px 0 0}.del{border:0;background:transparent;color:#a3312b;font-size:13px;padding:4px}.totals{display:flex;justify-content:space-between;padding:7px 0;font-size:15px}.empty{color:#718096;font-size:14px;padding:8px 0}.foot{font-size:12px;color:#718096;text-align:center;padding:12px}.hidden{display:none}
</style></head><body>
<header class="head"><h1>Blasentagebuch</h1><div class="muted">Deine persönliche Tageserfassung</div></header>
<section class="card"><label for="day">Datum</label><input id="day" type="date"></section>
<section class="card"><h2 style="font-size:19px;margin:0 0 8px">Neuer Eintrag</h2>
<label>1. Uhrzeit auswählen</label><div class="timegrid"><div><label for="hour" style="font-weight:500;margin-top:0">Stunde</label><select id="hour"></select></div><div><label for="minute" style="font-weight:500;margin-top:0">Minute</label><select id="minute"></select></div></div>
<label for="fluid">2. Flüssigkeit</label><select id="fluid"><option>Wasser</option><option>Kaffee</option><option>Tee</option><option>Saft</option><option>Milch</option><option>Schorle</option><option>Sonstiges</option></select>
<label for="drink">Trinkmenge (ml)</label><input id="drink" type="number" inputmode="decimal" min="0" placeholder="z. B. 250">
<label for="urine">3. Urinmenge (ml)</label><input id="urine" type="number" inputmode="decimal" min="0" placeholder="z. B. 150">
<label>4. Dranggefühl</label><div class="urge" id="urge"><button type="button" data-v="0" class="active">0<small>Kein</small></button><button type="button" data-v="X">X<small>Leicht</small></button><button type="button" data-v="XX">XX<small>Mittel</small></button><button type="button" data-v="XXX">XXX<small>Stark</small></button></div>
<button class="primary" id="add">＋ Eintrag hinzufügen</button></section>
<section class="card"><div style="display:flex;justify-content:space-between;align-items:center"><h2 style="font-size:19px;margin:0">Tagesübersicht</h2><span class="muted" id="count">0 Einträge</span></div><div id="entries" class="empty">Für diesen Tag gibt es noch keine Einträge.</div><div id="summary" class="hidden"><hr style="border:0;border-top:1px solid #e8edf3;margin:12px 0"><div class="totals"><span>Trinkmenge gesamt</span><strong id="drinkTotal">0 ml</strong></div><div class="totals"><span>Urinmenge gesamt</span><strong id="urineTotal">0 ml</strong></div><button class="secondary" id="export">Tagesprotokoll kopieren</button><button class="secondary" id="csv">Tagesprotokoll als CSV speichern</button></div></section>
<div class="foot">Die Einträge werden lokal in diesem Browser auf diesem Gerät gespeichert. Bitte regelmäßig ein Protokoll exportieren.</div>
<script>
const $=id=>document.getElementById(id);const key='blasentagebuch-v1';let selected='0';let data={};
try{data=JSON.parse(localStorage.getItem(key)||'{}')}catch(e){data={}}
const now=new Date();const localDate=new Date(now-now.getTimezoneOffset()*60000).toISOString().slice(0,10);$('day').value=localDate;
for(let h=0;h<24;h++){let o=document.createElement('option');o.value=String(h).padStart(2,'0');o.textContent=String(h).padStart(2,'0');$('hour').append(o)}
for(let m=0;m<60;m+=5){let o=document.createElement('option');o.value=String(m).padStart(2,'0');o.textContent=String(m).padStart(2,'0');$('minute').append(o)}
$('hour').value=String(now.getHours()).padStart(2,'0');$('minute').value=String(Math.round(now.getMinutes()/5)*5%60).padStart(2,'0');
function save(){try{localStorage.setItem(key,JSON.stringify(data))}catch(e){alert('Speichern war nicht möglich. Bitte Speicherplatz prüfen und Protokoll exportieren.')}}
function list(){return data[$('day').value]||[]}
function render(){let a=list();$('count').textContent=a.length+' Einträge';$('entries').innerHTML='';$('summary').classList.toggle('hidden',!a.length);if(!a.length){$('entries').textContent='Für diesen Tag gibt es noch keine Einträge.';return}a.forEach((e,i)=>{let d=document.createElement('div');d.className='entry';let top=document.createElement('div');top.className='entrytop';let t=document.createElement('span');t.textContent=(i+1)+'. '+e.time+' Uhr';let b=document.createElement('button');b.className='del';b.textContent='Löschen';b.onclick=()=>{let x=list();x.splice(i,1);data[$('day').value]=x;save();render()};top.append(t,b);let p=document.createElement('p');p.textContent='Getrunken: '+(e.drink?e.drink+' ml – '+e.fluid:'–')+' · Urin: '+(e.urine?e.urine+' ml':'–')+' · Drang: '+e.urge;d.append(top,p);$('entries').append(d)});$('drinkTotal').textContent=a.reduce((s,e)=>s+(+e.drink||0),0)+' ml';$('urineTotal').textContent=a.reduce((s,e)=>s+(+e.urine||0),0)+' ml'}
document.querySelectorAll('#urge button').forEach(b=>b.onclick=()=>{selected=b.dataset.v;document.querySelectorAll('#urge button').forEach(x=>x.classList.toggle('active',x===b))});
$('add').onclick=()=>{let drink=$('drink').value.trim(),urine=$('urine').value.trim();if(!drink&&!urine){alert('Bitte Trinkmenge oder Urinmenge eintragen.');return}let date=$('day').value;if(!data[date])data[date]=[];data[date].push({time:$('hour').value+':'+$('minute').value,fluid:$('fluid').value,drink,urine,urge:selected});data[date].sort((a,b)=>a.time.localeCompare(b.time));save();$('drink').value='';$('urine').value='';selected='0';document.querySelectorAll('#urge button').forEach(x=>x.classList.toggle('active',x.dataset.v==='0'));render()};$('day').onchange=render;
function report(){let a=list();return 'BLASENTAGEBUCH\nDatum: '+$('day').value+'\n\n'+a.map((e,i)=>(i+1)+'. '+e.time+' Uhr | Trinken: '+(e.drink||'–')+' ml '+e.fluid+' | Urin: '+(e.urine||'–')+' ml | Drang: '+e.urge).join('\n')+'\n\nTrinkmenge gesamt: '+a.reduce((s,e)=>s+(+e.drink||0),0)+' ml\nUrinmenge gesamt: '+a.reduce((s,e)=>s+(+e.urine||0),0)+' ml'}
$('export').onclick=async()=>{try{await navigator.clipboard.writeText(report());alert('Tagesprotokoll wurde kopiert. Du kannst es in Notizen einfügen.')}catch(e){let ta=document.createElement('textarea');ta.value=report();document.body.append(ta);ta.select();document.execCommand('copy');ta.remove();alert('Tagesprotokoll kopiert.')}};
$('csv').onclick=()=>{let rows=[['Uhrzeit','Flüssigkeit','Trinkmenge ml','Urinmenge ml','Dranggefühl'],...list().map(e=>[e.time,e.fluid,e.drink,e.urine,e.urge])];let csv=rows.map(r=>r.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(';')).join('\n');let blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});let url=URL.createObjectURL(blob);let a=document.createElement('a');a.href=url;a.download='Blasentagebuch-'+$('day').value+'.csv';a.click();URL.revokeObjectURL(url)};
render();
</script></body></html>
